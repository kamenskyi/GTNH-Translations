    S:TileEntity_DESCRIPTION_10507_Index_12=  §8《§b液体窒素§8／Liquid Nitrogen》§7 : §690K
    S:TileEntity_DESCRIPTION_10507_Index_13=  §8《§b液体酸素§8／Liquid Oxygen》§7 : §690K
    S:TileEntity_DESCRIPTION_10507_Index_14=  §8《§b超型冷却材§8／Super Coolant》§7 : §61K
    S:TileEntity_DESCRIPTION_10507_Index_15=There are two types of §3Antenna Casings§7, upgrade them to improve the machine
    S:TileEntity_DESCRIPTION_10507_Index_16=All energies in the following formulae must be in keV
    S:TileEntity_DESCRIPTION_10507_Index_17=§7§m-----------------------------------------
    S:TileEntity_DESCRIPTION_10507_Index_18=§9Output Beam Energy§7§f = §cIR §f* §2Power Scale Factor
    S:TileEntity_DESCRIPTION_10507_Index_19=where §cIR §f =  (§eInput Beam Energy§f)^(1.13*(§3Antenna Tier§f)^(4/9))/40,000,000
    S:TileEntity_DESCRIPTION_10507_Index_20=and §2Power Scale Factor§f = 1 - 0.15^(§9Total EU/t Provided§f / (30,384 * (§3Antenna Tier§f)^(5/2)))
    S:TileEntity_DESCRIPTION_10507_Index_21=§7§m-----------------------------------------
    S:TileEntity_DESCRIPTION_10507_Index_22=§cOutput Beam Focus§7§f = (§eInput Beam Focus§f + §aMachine Focus§f)/2.5
    S:TileEntity_DESCRIPTION_10507_Index_23=§fwhere §aMachine Focus§f = max(min(1.5^(12 - §6Coolant Temperature§f/40), 90), 10)
    S:TileEntity_DESCRIPTION_10507_Index_24=§7§m-----------------------------------------
